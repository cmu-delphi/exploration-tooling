[Unit]
Description=Run flu/covid prod forecasts once NHSN/NSSP data is fresh

[Service]
Type=oneshot
WorkingDirectory=%h/prod/exploration-tooling-2024
Environment=PATH=/home/forecaster/.nvm/versions/node/v23.3.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -c 'source ~/.profile && Rscript scripts/run_prod_if_fresh.R'
